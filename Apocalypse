-- [[ 3. VISUALS ]] --
local Visuals = Window:NewTab("3. Visuals")
local VisualSec = Visuals:NewSection("ESP & World")

VisualSec:NewToggle("Player ESP", "มองเห็นผู้เล่นคนอื่นทะลุกำแพง", function(state)
    _G.ESP = state
    if state then
        for _, v in pairs(game.Players:GetPlayers()) do
            if v ~= game.Players.LocalPlayer and v.Character then
                local h = Instance.new("Highlight", v.Character)
                h.Name = "ZuESP"
                h.FillColor = Color3.fromRGB(255, 0, 0)
            end
        end
    else
        for _, v in pairs(game.Players:GetPlayers()) do
            if v.Character and v.Character:FindFirstChild("ZuESP") then
                v.Character.ZuESP:Destroy()
            end
        end
    end
end)

VisualSec:NewButton("Full Bright", "ทำให้แมพสว่างเหมือนตอนกลางวัน", function()
    game.Lighting.Brightness = 2
    game.Lighting.ClockTime = 14
end)

