-- [[ 1. MAIN ]] --
local Main = Window:NewTab("1. Main")
local MainSec = Main:NewSection("Survival & Movement")

MainSec:NewToggle("Infinite Stamina", "วิ่งได้ตลอดกาลโดยไม่มีวันเหนื่อย", function(state)
    _G.InfStamina = state
    while _G.InfStamina do
        task.wait()
        pcall(function() game.Players.LocalPlayer.Character.Stamina.Value = 100 end)
    end
end)

MainSec:NewSlider("WalkSpeed", "ปรับความเร็วในการเคลื่อนที่", 250, 16, function(s)
    pcall(function() game.Players.LocalPlayer.Character.Humanoid.WalkSpeed = s end)
end)

